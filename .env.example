# Coordinator
API_PORT=8080
DASHBOARD_PORT=3000
DATABASE_URL=postgres://foreman:foreman@localhost:5432/foreman?sslmode=disable
REDIS_URL=redis://localhost:6379
PORT=8080
COORDINATOR_SECRET=dev-secret-change-in-prod
MAX_PARALLEL_JOBS_PER_WORKER=4
# Delete finished jobs (and expire stored artifacts/logs) after this many days; 0 keeps everything
RETENTION_DAYS=30
# Read X-Forwarded-For for per-visitor demo limits; enable only behind a trusted proxy
TRUST_PROXY=false

# MinIO artifact storage
MINIO_ENDPOINT=localhost:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=foreman-artifacts
MINIO_USE_SSL=false

# Worker
COORDINATOR_URL=http://localhost:8080
WORKER_CPU_CORES=2
WORKER_MEMORY_MB=1024
WORKER_MAX_PARALLEL_JOBS=4
# Comma-separated labels that jobs can target with a selector, e.g. region=eu,gpu=true
WORKER_LABELS=
# Network for job containers: none (default, isolated) or bridge to allow outbound access
WORKER_JOB_NETWORK=none
